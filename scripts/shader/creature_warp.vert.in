// Creature warp (vertex). GENERATED by scripts/optimize_creature.py from
// scripts/shader/creature_warp.vert.in. Per-frame values of the replaced effects that do not
// depend on the pixel (spin angles, iris offsets, twirl angles, Balance phase, blinks) are worked
// out here once, with each built-in's own vertex math.

#include "common.h"

uniform mat4 g_ModelViewProjectionMatrix;
uniform float g_Time;
uniform vec4 g_UvRect; // {"material":"uvrect","label":"Layer rect in full uv","default":"0 0 1 1"}

attribute vec3 a_Position;
attribute vec2 a_TexCoord;

varying vec4 v_TexCoord;
varying vec4 v_Spin12;
varying vec4 v_Spin34;
varying vec4 v_Iris;
varying vec4 v_Misc;
varying vec4 v_Blink;
varying vec4 v_Misc2;

@@CONSTANTS@@

vec2 cs(float a)
{
	return vec2(cos(a), sin(a));
}

// WE iris offset
vec2 irisOffset(float speed, float phase, float rough, float noiseAmount, vec2 scale)
{
	float time = (g_Time * speed) + phase;
	float lowDt = floor(time);
	vec2 motion2 = sin(1.9 * (lowDt + vec2(0, 1)));
	vec4 motion4 = sin(2.5 * (lowDt + vec4(0, 0, 1, 1)) + vec4(1, 2, 1, 2));
	vec2 moveStart = motion2.xx + motion4.xy;
	vec2 moveEnd = motion2.yy + motion4.zw;
	vec2 da = mix(moveStart, moveEnd, smoothstep(1.0 - rough, 1.0, cos(frac(time) * M_PI) * -0.5 + 0.5));
	da.x += sin(time) * noiseAmount;
	da.y += cos(time) * noiseAmount;
	return da * scale * 0.001;
}

// WE pulse without audio (alpha only, no noise)
float blinkPulse(float phase)
{
	float p = smoothstep(BLINK_BOUNDS.x, BLINK_BOUNDS.y, sin(g_Time * BLINK_SPEED + (phase - 1.57079632679)) * 0.5 + 0.5) * BLINK_AMOUNT;
	return pow(p, BLINK_POWER);
}

void main() {
	gl_Position = mul(vec4(a_Position, 1.0), g_ModelViewProjectionMatrix);
	v_TexCoord.xy = a_TexCoord;
	v_TexCoord.zw = g_UvRect.xy + a_TexCoord * g_UvRect.zw;

	v_Spin12 = vec4(cs(S1_SPEED * g_Time + S1_PHASE * 6.28318530718), cs(S2_SPEED * g_Time + S2_PHASE * 6.28318530718));
	v_Spin34 = vec4(cs(S3_SPEED * g_Time + S3_PHASE * 6.28318530718), cs(S4_SPEED * g_Time + S4_PHASE * 6.28318530718));
	v_Iris = vec4(irisOffset(I1_SPEED, I1_PHASE, I1_ROUGH, I1_NOISE, I1_SCALE),
		irisOffset(I2_SPEED, I2_PHASE, I2_ROUGH, I2_NOISE, I2_SCALE));

	// Balance: WE shake, direction "left" (0..1 swing), no noise, friction 1 1, bounds 0 1
	float bt = SH_SPEED * g_Time;
	float bo = sin(frac(bt / M_PI_2) * M_PI_2) * 0.498 + 0.5;
	v_Misc.x = sin(g_Time * W1_SPEED + W1_PHASE * 6.28318530718) * W1_AMOUNT;
	v_Misc.y = sin(g_Time * W2_SPEED + W2_PHASE * 6.28318530718) * W2_AMOUNT;
	v_Misc.z = saturate(bo);
	v_Misc.w = 0.0;
	v_Blink = vec4(blinkPulse(BLINK1_PHASE), blinkPulse(BLINK2_PHASE), blinkPulse(BLINK3_PHASE), blinkPulse(BLINK4_PHASE));
	v_Misc2 = vec4(blinkPulse(BLINK5_PHASE), 0.0, 0.0, 0.0);
}
