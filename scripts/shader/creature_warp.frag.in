// Creature warp (fragment). GENERATED by scripts/optimize_creature.py from
// scripts/shader/creature_warp.frag.in: edit those, not shaders/effects/creature_warp.frag.
//
// One pass per creature layer instead of the chain of 7-27 built-in effect passes it replaces.
// Every replaced effect is reproduced with WE's own math and the scene's own values (baked in as
// the constants below), composed in the same order. A chain of passes samples each pass's output
// at a displaced point, so the whole chain is a composition of coordinate maps: walk it from the
// last effect back to the first, moving the sample point, then read the texture once. That gives
// the same image without the intermediate render targets (and without their extra bilinear
// resampling, so it is slightly sharper). Effects that mix two samples (spin's feathered rim)
// carry a second sample point for the rest of the walk.
//
// Layouts (combo LAYOUT), one per kind of layer:
//   0 RIG      Shadow, W            Hair, Tail, Head & Body, Belly, Face, Lens, Fold clip
//   1 CSTACK   C, M, C2             Olhar, Olho, Olho menor, Guelras, Little Eyes, Nose
//                                   twirl, Tail edge shimmer, Balance, Mini Eye 1/2, Strings Hair,
//                                   Strings Back, Honeycomb, the five rigs, Lens, Fold clip
//   2 KPRE     K, pass 1            Blink 1-5, Olhar, Olho, Olho menor, Guelras, Guelras (2) radial
//                                   blur, Little Eyes            (then WE's own Ink edges pass)
//   3 KPOST    K, pass 3            Nose twirl ... Honeycomb, the five rigs, Lens, Fold clip
//   4 CBCHEST  CB_Chest             Guelras, Balance, Head & Body, Belly, Lens, Fold clip
//   5 CBTAIL2  CB_Tail2             Tail edge shimmer, Tail, Head & Body, Belly, Lens, clip
//   6 CBTAIL   CB_Tail1/3/4         Tail, Head & Body, Belly, Lens, Fold clip
//
// The colour layers keep WE's own audio pulse as their first pass (its output feeds this one), so
// the audio response and tint are exactly the built-in ones.
//
// Coordinates: the layers are cropped to the area the creature can reach (smaller render targets);
// all effect math runs in the original full-layer UV space ("full uv", 0..1 over 5040x2160), and
// g_UvRect maps the cropped layer onto it. Pixels whose lens sample point is outside the layer's
// support (its alpha dilated by the largest possible warp) are transparent in the original too, so
// they are written as transparent without running the chain.

// [COMBO] {"material":"Layout","combo":"LAYOUT","type":"options","default":0,"options":{"RIG":0,"CSTACK":1,"KPRE":2,"KPOST":3,"CBCHEST":4,"CBTAIL2":5,"CBTAIL":6}}

#include "common.h"

varying vec4 v_TexCoord;     // xy = local layer uv, zw = full uv
varying vec4 v_Spin12;       // cos/sin of the spin angle: Olhar, Olho
varying vec4 v_Spin34;       // Mini Eye 1, Mini Eye 2
varying vec4 v_Iris;         // xy = Olho menor offset, zw = Little Eyes offset
varying vec4 v_Misc;         // x = Nose twirl angle, y = Honeycomb angle, z = Balance offset, w = unused
varying vec4 v_Blink;        // blink pulses 1-4
varying vec4 v_Misc2;        // x = blink pulse 5

uniform sampler2D g_Texture0; // {"hidden":true}
uniform sampler2D g_Texture1; // {"label":"Pack A: hair flow, hair time, tail time","mode":"flowmask","default":"util/noflow"}
uniform sampler2D g_Texture2; // {"label":"Pack B: tail sway flow, tail follow flow","mode":"flowmask","default":"util/noflow"}
uniform sampler2D g_Texture3; // {"label":"Pack C: head-body flow, head-body time, belly time","mode":"flowmask","default":"util/noflow"}
uniform sampler2D g_Texture4; // {"label":"Pack D: belly flow, balance flow","mode":"flowmask","default":"util/noflow"}
uniform sampler2D g_Texture5; // {"label":"Pack face: face flow, face time","mode":"flowmask","default":"util/noflow"}
uniform sampler2D g_Texture6; // {"label":"Masks: olho menor, little eyes, guelras, shimmer","mode":"opacitymask","default":"util/black"}
uniform sampler2D g_Texture7; // {"label":"Masks: strings hair, strings back, blink 5, guelras blur","mode":"opacitymask","default":"util/black"}
uniform sampler2D g_Texture8; // {"label":"Support masks (K pass 1: blink 1-4)","mode":"opacitymask","default":"util/white"}
uniform sampler2D g_Texture9; // {"label":"Noise","default":"util/noise"}
// WE binds g_Texture0..9 only. K pass 1 has no rigs, so it takes its support masks in slot 1
// and the blink masks in slot 8.
#if LAYOUT == 2
#define SUPPORT_TEX g_Texture1
#define BLINK_TEX g_Texture8
#else
#define SUPPORT_TEX g_Texture8
#endif

uniform float g_Time;
uniform vec4 g_UvRect; // {"material":"uvrect","label":"Layer rect in full uv","default":"0 0 1 1"}
uniform vec4 g_SupportSel; // {"material":"supportsel","label":"Support channel","default":"1 0 0 0"}
uniform float g_Follow; // {"material":"follow","label":"Mouse follow (-1..1)","default":0,"range":[-1,1]}
uniform float g_AlphaMax; // {"material":"alphamax","label":"Alpha cap of the input","default":1000}

@@CONSTANTS@@

#if LAYOUT == 0
#define R_HAIR 1
#define R_TAIL 1
#define R_HB 1
#define R_BELLY 1
#define R_FACE 1
#define LENS 1
#endif
#if LAYOUT == 1
#define E_S1 1
#define E_S2 1
#define E_I1 1
#define E_F1 1
#define E_I2 1
#define E_W1 1
#define E_WW 1
#define E_SH 1
#define E_S3 1
#define E_S4 1
#define E_F2 1
#define E_F3 1
#define E_W2 1
#define R_HAIR 1
#define R_TAIL 1
#define R_HB 1
#define R_BELLY 1
#define R_FACE 1
#define LENS 1
#endif
#if LAYOUT == 2
#define BLINK 1
#define E_S1 1
#define E_S2 1
#define E_I1 1
#define E_F1 1
#define E_BLUR 1
#define E_I2 1
#endif
#if LAYOUT == 3
#define E_W1 1
#define E_WW 1
#define E_SH 1
#define E_S3 1
#define E_S4 1
#define E_F2 1
#define E_F3 1
#define E_W2 1
#define R_HAIR 1
#define R_TAIL 1
#define R_HB 1
#define R_BELLY 1
#define R_FACE 1
#define LENS 1
#endif
#if LAYOUT == 4
#define E_F1 1
#define E_SH 1
#define R_HB 1
#define R_BELLY 1
#define LENS 1
#endif
#if LAYOUT == 5
#define E_WW 1
#define R_TAIL 1
#define R_HB 1
#define R_BELLY 1
#define LENS 1
#endif
#if LAYOUT == 6
#define R_TAIL 1
#define R_HB 1
#define R_BELLY 1
#define LENS 1
#endif

// WE's translator only lets main() read varyings, so the per-frame values travel as arguments.
#define ANIM_PARAMS vec4 aSpin12, vec4 aSpin34, vec4 aIris, vec4 aMisc, vec4 aBlink, vec4 aMisc2
#define ANIM_ARGS aSpin12, aSpin34, aIris, aMisc, aBlink, aMisc2

vec2 rot2(vec2 v, vec2 cs)
{
	return vec2(v.x * cs.x - v.y * cs.y, v.x * cs.y + v.y * cs.x);
}

bool inBox(vec2 p, vec4 box)
{
	return p.x >= box.x && p.y >= box.y && p.x <= box.z && p.y <= box.w;
}

vec2 flowOf(vec2 rg)
{
	return (rg - vec2(0.498, 0.498)) * 2.0;
}

// ---- WE shake (rigs): no noise, friction 1 1, bounds 0 1, direction centre, time-offset map ----
float rigWave(float speed, float phase01)
{
	float t = speed * g_Time + phase01 * M_PI_2;
	return sin(frac(t / M_PI_2) * M_PI_2) * 0.996;
}

vec2 opHair(vec2 p)
{
#if R_HAIR
	if (inBox(p, BOX_HAIR))
	{
		vec4 a = texSample2D(g_Texture1, p);
		p += rigWave(HAIR_SPEED, a.b) * HAIR_AMP2 * flowOf(a.rg);
	}
#endif
	return p;
}

vec2 opTail(vec2 p)
{
#if R_TAIL
	if (inBox(p, BOX_TAIL))
	{
		float phase = texSample2D(g_Texture1, p).a * M_PI_2;
		vec4 b = texSample2D(g_Texture2, p);
		float sway = sin(TAIL_SPEED * g_Time + phase) * 0.996;
		float f = clamp(g_Follow, -1.0, 1.0);
		p += sway * (1.0 - abs(f)) * TAIL_AMP2 * flowOf(b.rg) - f * TAIL_FOLLOW_AMP2 * flowOf(b.ba);
	}
#endif
	return p;
}

vec2 opHeadBody(vec2 p)
{
#if R_HB
	if (inBox(p, BOX_HB))
	{
		vec4 c = texSample2D(g_Texture3, p);
		p += rigWave(HB_SPEED, c.b) * HB_AMP2 * flowOf(c.rg);
	}
#endif
	return p;
}

vec2 opBelly(vec2 p)
{
#if R_BELLY
	if (inBox(p, BOX_BELLY))
	{
		float phase = texSample2D(g_Texture3, p).a;
		vec2 flow = texSample2D(g_Texture4, p).rg;
		p += rigWave(BELLY_SPEED, phase) * BELLY_AMP2 * flowOf(flow);
	}
#endif
	return p;
}

vec2 opFace(vec2 p)
{
#if R_FACE
	if (inBox(p, BOX_FACE))
	{
		vec4 f = texSample2D(g_Texture5, p);
		p += rigWave(FACE_SPEED, f.b) * FACE_AMP2 * flowOf(f.rg);
	}
#endif
	return p;
}

// ---- WE twirl: elliptical, repeat, no noise, no inner, no mask ----
vec2 opTwirl(vec2 p, vec2 center, vec2 axis, float ratio, float size, float feather, float angle)
{
	vec2 t = p - center;
	t.x *= ASPECT;
	t = rot2(t, axis);
	t.x *= ratio;
	float len = length(t);
	float fe = smoothstep(size + feather + 0.00001, size - feather, len);
	if (fe <= 0.0)
	{
		return p;
	}
	float anim = angle * len / size;
	t = rot2(t, vec2(cos(anim), sin(anim)));
	t.x /= ratio;
	t = rot2(t, vec2(axis.x, -axis.y));
	t.x /= ASPECT;
	return mix(p, frac(t + center), fe);
}

// ---- WE spin: elliptical, repeat, no noise, no mask; returns the soft mask, q = rotated point ----
float spinMask(vec2 p, vec2 center, vec2 axis, float ratio, float size, float feather)
{
	vec2 v = p - center;
	v.x *= ASPECT;
	v = rot2(v, axis);
	v.x *= ratio;
	return smoothstep(size + feather + 0.00001, size - feather, length(v));
}

vec2 spinPoint(vec2 p, vec2 center, vec2 axis, float ratio, vec2 spin)
{
	vec2 v = p - center;
	v.x *= ASPECT;
	v = rot2(v, axis);
	v.x *= ratio;
	v = rot2(v, spin);
	v.x /= ratio;
	v = rot2(v, vec2(axis.x, -axis.y));
	v.x /= ASPECT;
	return frac(v + center);
}

// ---- WE iris with an opacity mask, no background ----
vec2 opIris(vec2 p, float mask, vec2 da)
{
	return p + da * mask;
}

// ---- WE foliage sway, UV mode, opacity mask, util/noise ----
vec2 opFoliage(vec2 p, float mask, float noiseScale, vec2 noiseDir, vec2 dirCS, float amp0, float phaseK, float speed, float power)
{
	if (mask <= 0.0)
	{
		return p;
	}
	float noise = texSample2D(g_Texture9, p * noiseScale).g;
	float amp = amp0 * mask;
	vec2 pr = rot2(p, dirCS);
	float phase = (noise * M_PI * 2.0 + pr.x * 10.0 + pr.y * 5.0) * phaseK;
	vec4 sines = sin(phase + speed * g_Time * vec4(1, -0.16161616, 0.0083333, -0.00019841));
	vec4 csines = sin(0.4 + phase + speed * g_Time * vec4(-0.5, 0.041666666, -0.0013888889, 0.000024801587));
	sines = pow(abs(sines), CAST4(power)) * sign(sines);
	csines = pow(abs(csines), CAST4(power)) * sign(csines);
	return p + vec2(noiseDir.x * dot(sines, CAST4(amp)), noiseDir.y * dot(csines, CAST4(amp)));
}

// ---- WE water waves, opacity mask, single wave, no perspective ----
vec2 opWaves(vec2 p, float mask)
{
	if (mask <= 0.0)
	{
		return p;
	}
	float dist = g_Time * WW_SPEED + dot(p, WW_DIR) * WW_SCALE;
	float val = sin(dist);
	return p + pow(abs(val), WW_EXP) * sign(val) * vec2(WW_DIR.y, -WW_DIR.x) * WW_STRENGTH2 * mask;
}

// ---- the walk, from the last effect back to the first ----

// Rigs (applied in reverse: Face, Belly, Head & Body, Tail, Hair).
vec2 walkRigs(vec2 p)
{
	p = opFace(p);
	p = opBelly(p);
	p = opHeadBody(p);
	p = opTail(p);
	p = opHair(p);
	return p;
}

// Honeycomb, Strings Back, Strings Hair (effects 14, 13, 12).
vec2 walkLate(vec2 p, ANIM_PARAMS)
{
#if E_W2
	p = opTwirl(p, W2_CENTER, W2_AXIS, W2_RATIO, W2_SIZE, W2_FEATHER, aMisc.y);
#endif
#if E_F3
	if (inBox(p, BOX_F3)) p = opFoliage(p, texSample2D(g_Texture7, p).g, F3_NSCALE, F3_NDIR, F3_DIR, F3_AMP0, F3_PHASE, F3_SPEED, F3_POWER);
#endif
#if E_F2
	if (inBox(p, BOX_F2)) p = opFoliage(p, texSample2D(g_Texture7, p).r, F2_NSCALE, F2_NDIR, F2_DIR, F2_AMP0, F2_PHASE, F2_SPEED, F2_POWER);
#endif
	return p;
}

// Balance, Tail edge shimmer, Nose twirl, Little Eyes, Guelras, Olho menor (effects 9..4).
vec2 walkMid(vec2 p, ANIM_PARAMS)
{
#if E_SH
	if (inBox(p, BOX_SH)) p += aMisc.z * SH_AMP2 * flowOf(texSample2D(g_Texture4, p).ba);
#endif
#if E_WW
	if (inBox(p, BOX_WW)) p = opWaves(p, texSample2D(g_Texture6, p).a);
#endif
#if E_W1
	p = opTwirl(p, W1_CENTER, W1_AXIS, W1_RATIO, W1_SIZE, W1_FEATHER, aMisc.x);
#endif
#if E_I2 && LAYOUT != 2
	if (inBox(p, BOX_I2)) p = opIris(p, texSample2D(g_Texture6, p).g, aIris.zw);
#endif
#if E_F1
	if (inBox(p, BOX_F1)) p = opFoliage(p, texSample2D(g_Texture6, p).b, F1_NSCALE, F1_NDIR, F1_DIR, F1_AMP0, F1_PHASE, F1_SPEED, F1_POWER);
#endif
#if E_I1
	if (inBox(p, BOX_I1)) p = opIris(p, texSample2D(g_Texture6, p).r, aIris.xy);
#endif
	return p;
}

// A spin step on the (pA, pB, w) pair: colour = mix(X(pA), X(pB), w).
void spinStep(inout vec2 pA, inout vec2 pB, inout float w, inout float split,
	vec2 center, vec2 axis, float ratio, float size, float feather, vec2 spin)
{
	float m = spinMask(pA, center, axis, ratio, size, feather);
	if (m > 0.0)
	{
		vec2 q = spinPoint(pA, center, axis, ratio, spin);
		if (m >= 1.0)
		{
			pA = q;
		}
		else if (split < 0.5)
		{
			pB = q;
			w = m;
			split = 1.0;
		}
		else
		{
			pA = mix(pA, q, m);   // two rims at once: does not happen with these eyes
		}
	}
	if (split > 0.5)
	{
		float mb = spinMask(pB, center, axis, ratio, size, feather);
		if (mb > 0.0)
		{
			pB = mix(pB, spinPoint(pB, center, axis, ratio, spin), mb);
		}
	}
}

vec4 readTex(vec2 p, ANIM_PARAMS)
{
	vec4 c = texSample2D(g_Texture0, (p - g_UvRect.xy) / g_UvRect.zw);
	c.a = min(c.a, g_AlphaMax);      // M: its old motion blur kept the pulsed image in an 8-bit buffer
#if BLINK
	if (inBox(p, BOX_BLINK))
	{
		vec4 m = texSample2D(BLINK_TEX, p);
		float m5 = texSample2D(g_Texture7, p).b;
		c.a *= (1.0 - m.r * (1.0 - aBlink.x)) * (1.0 - m.g * (1.0 - aBlink.y))
			* (1.0 - m.b * (1.0 - aBlink.z)) * (1.0 - m.a * (1.0 - aBlink.w))
			* (1.0 - m5 * (1.0 - aMisc2.x));
	}
#endif
	return c;
}

// Olhar and Olho (effects 2, 3) and the texture read, for a point that has been through the rest.
vec4 walkEarly(vec2 pA, vec2 pB, float w, float split, ANIM_PARAMS)
{
#if E_S2
	spinStep(pA, pB, w, split, S2_CENTER, S2_AXIS, S2_RATIO, S2_SIZE, S2_FEATHER, aSpin12.zw);
#endif
#if E_S1
	spinStep(pA, pB, w, split, S1_CENTER, S1_AXIS, S1_RATIO, S1_SIZE, S1_FEATHER, aSpin12.xy);
#endif
	vec4 c = readTex(pA, ANIM_ARGS);
	if (split > 0.5)
	{
		c = mix(c, readTex(pB, ANIM_ARGS), w);
	}
	return c;
}

// The whole chain for one sample point (full uv) entering after the lens.
vec4 chain(vec2 p, ANIM_PARAMS)
{
	p = walkRigs(p);
	p = walkLate(p, ANIM_ARGS);
	vec2 pB = p;
	float w = 0.0;
	float split = 0.0;
#if E_S4
	spinStep(p, pB, w, split, S4_CENTER, S4_AXIS, S4_RATIO, S4_SIZE, S4_FEATHER, aSpin34.zw);
#endif
#if E_S3
	spinStep(p, pB, w, split, S3_CENTER, S3_AXIS, S3_RATIO, S3_SIZE, S3_FEATHER, aSpin34.xy);
#endif
	p = walkMid(p, ANIM_ARGS);
	if (split > 0.5)
	{
		pB = walkMid(pB, ANIM_ARGS);
	}
	return walkEarly(p, pB, w, split, ANIM_ARGS);
}

#if LAYOUT == 2
// K pass 1: Little Eyes on top of the Guelras radial blur on top of the earlier effects.
vec4 preBlur(vec2 q, ANIM_PARAMS)
{
	q = walkMid(q, ANIM_ARGS);
	return walkEarly(q, q, 0.0, 0.0, ANIM_ARGS);
}

vec4 kPre(vec2 p, ANIM_PARAMS)
{
	if (inBox(p, BOX_I2)) p = opIris(p, texSample2D(g_Texture6, p).g, aIris.zw);
	vec4 c = preBlur(p, ANIM_ARGS);
	if (inBox(p, BOX_BLUR))
	{
		float mb = texSample2D(g_Texture7, p).a;
		if (mb > 0.0)
		{
			vec2 delta = p - BLUR_CENTER;
			float amt = BLUR_SCALE * 0.025;
			vec2 r1 = rot2(delta, vec2(cos(1.4091998770852122 * amt), sin(1.4091998770852122 * amt))) - delta;
			vec2 r2 = rot2(delta, vec2(cos(3.2979348079914822 * amt), sin(3.2979348079914822 * amt))) - delta;
			vec2 r3 = rot2(delta, vec2(cos(5.2062900776825969 * amt), sin(5.2062900776825969 * amt))) - delta;
			vec4 b = c * 0.1976406528809576
				+ (preBlur(p + r1, ANIM_ARGS) + preBlur(p - r1, ANIM_ARGS)) * 0.2959855056006557
				+ (preBlur(p + r2, ANIM_ARGS) + preBlur(p - r2, ANIM_ARGS)) * 0.0935333619980593
				+ (preBlur(p + r3, ANIM_ARGS) + preBlur(p - r3, ANIM_ARGS)) * 0.0116608059608062;
			c = mix(c, b, mb);
		}
	}
	return c;
}
#endif

void main() {
	vec2 uv = v_TexCoord.zw;                         // full uv of this output pixel
	vec4 aSpin12 = v_Spin12;
	vec4 aSpin34 = v_Spin34;
	vec4 aIris = v_Iris;
	vec4 aMisc = v_Misc;
	vec4 aBlink = v_Blink;
	vec4 aMisc2 = v_Misc2;
	vec4 c = CAST4(0.0);

#if LAYOUT == 2
	if (dot(texSample2D(SUPPORT_TEX, uv), g_SupportSel) > 0.0)
	{
		c = kPre(uv, ANIM_ARGS);
	}
#else
	// Lens distortion (workshop 2811235087: barrel + chromatic aberration) and its fold clip
	vec2 base = uv - LENS_CENTER;
	vec2 d = base / LENS_SCALE;
	float len2 = dot(d, d);
	float clip = 1.0 - smoothstep(FOLD_FROM, FOLD_TO, len2);
	vec2 uvG = LENS_CENTER + base * (1.0 + LENS_K * len2);
	if (clip > 0.0 && dot(texSample2D(SUPPORT_TEX, uvG), g_SupportSel) > 0.0)
	{
		vec2 uvR = LENS_CENTER + base * (1.0 + (LENS_K + LENS_CA) * len2);
		vec2 uvB = LENS_CENTER + base * (1.0 + (LENS_K - LENS_CA) * len2);
		c = chain(uvG, ANIM_ARGS);
		c.r = chain(uvR, ANIM_ARGS).r;
		c.b = chain(uvB, ANIM_ARGS).b;
		c.a *= clip;
	}
#endif
	gl_FragColor = c;
}
