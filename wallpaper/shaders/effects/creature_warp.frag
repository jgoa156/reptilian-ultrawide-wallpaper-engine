// ---- WE shake (rigs): no noise, friction 1 1, bounds 0 1, direction centre, time-offset map ----
float rigWave(float speed, float phase01)
{
	float t = speed * g_Time + phase01 * M_PI_2;
	return sin(frac(t / M_PI_2) * M_PI_2) * 0.996;
}

vec2 opHair(vec2 p)
{
#if R_HAIR
	if (inBox(p, BOX_HAIR))
	{
		vec4 a = texSample2D(g_Texture1, p);
		p += rigWave(HAIR_SPEED, a.b) * HAIR_AMP2 * (1.0 + BRISTLE * g_Loud) * flowOf(a.rg);
	}
#endif
	return p;
}

vec2 opTail(vec2 p)
{
#if R_TAIL
	if (inBox(p, BOX_TAIL))
	{
		float phase = texSample2D(g_Texture1, p).a * M_PI_2;
		vec4 b = texSample2D(g_Texture2, p);
		float sway = sin(TAIL_SPEED * g_Time + phase) * 0.996;
		float f = clamp(g_Follow, -1.0, 1.0);
		// follow field: x only, 16 bits over b (hi) and a (lo); linear filtering commutes with this
		float fx = (dot(b.ba, vec2(65280.0, 255.0)) - 32640.0) / 32640.0;
		p += sway * (1.0 - abs(f)) * TAIL_AMP2 * flowOf(b.rg) - f * TAIL_FOLLOW_AMP2 * vec2(fx, 0.0);
	}
#endif
	return p;
}

vec2 opHeadBody(vec2 p)
{
#if R_HB
	if (inBox(p, BOX_HB))
	{
		vec4 c = texSample2D(g_Texture3, p);
		p += rigWave(HB_SPEED, c.b) * HB_AMP2 * flowOf(c.rg);
	}
#endif
	return p;
}

vec2 opBelly(vec2 p)
{
#if R_BELLY
	if (inBox(p, BOX_BELLY))
	{
		vec2 p0 = p;
		float phase = texSample2D(g_Texture3, p).a;
		vec2 fl = flowOf(texSample2D(g_Texture4, p).rg);
		// breathing (doubled) + bass heave: the same outward field, the heave without the wave
		p += (rigWave(BELLY_SPEED, phase) * BREATH_GAIN + HEAVE_GAIN * g_Bass) * BELLY_AMP2 * fl;
		// muscle ripple: stripe tensor T from the fitted field, slide by T * RIP_DIR (no stripe sign needed)
		float m = smoothstep(0.0, 0.3 * RIP_FLOWMAX, length(fl));
		if (m > 0.0)
		{
			vec2 u = (p0 - RIP_CENTER) * ARM_PX / RIP_SCALE;
			vec4 q1 = vec4(1.0, u.x, u.y, u.x * u.x);
			vec3 q2 = vec3(u.x * u.y, u.y * u.y, u.x * u.x * u.x);
			vec3 q3 = vec3(u.x * u.x * u.y, u.x * u.y * u.y, u.y * u.y * u.y);
			vec2 cs2 = vec2(dot(RIP_C0, q1) + dot(RIP_C1, q2) + dot(RIP_C2, q3),
				dot(RIP_S0, q1) + dot(RIP_S1, q2) + dot(RIP_S2, q3));
			vec2 n = cs2 / max(length(cs2), 0.5);
			vec2 tg = 0.5 * (RIP_DIR + vec2(n.x * RIP_DIR.x + n.y * RIP_DIR.y, n.y * RIP_DIR.x - n.x * RIP_DIR.y));
			float ph = RIP_K * dot(p0 * ARM_PX, RIP_DIR) - RIP_W * g_Time;
			p += m * RIP_AMP * (1.0 + 0.5 * g_Loud) * sin(ph) * tg / ARM_PX;
		}
	}
#endif
	return p;
}

// Weight shift: a slow lean of the whole body about its pinned bottom-right corner.
vec2 opLean(vec2 p)
{
#if R_HB
	vec2 d = p * ARM_PX - LEAN_PIVOT;
	float a = LEAN_ANGLE * sin(LEAN_SPEED * g_Time);
	vec2 r = rot2(d, vec2(cos(a), -sin(a))) - d;
	r.x *= smoothstep(0.0, LEAN_FADE, -d.x);
	r.y *= smoothstep(0.0, LEAN_FADE, -d.y);
	p += r / ARM_PX;
#endif
	return p;
}

// Jaw snap: the lower jaw (mouth line .. neck, chin tendrils included) turns about its hinge. Wide
// feathers (80 px) at the snout tip and the neck keep the ink strain at the 1.15 overshoot <= 0.56
// (a 15 px feather tore the tendril roots: numpy mirror, 2026-11-09).
vec2 opJaw(vec2 p)
{
#if R_FACE
	if (g_Jaw > 0.001)
	{
		vec2 x = p * ARM_PX;
		vec2 d = x - JAW_HINGE;
		float side = max(smoothstep(-40.0, 40.0, dot(x - JAW_MOUTH_A, JAW_MOUTH_N)), smoothstep(1295.0, 1375.0, x.y));
		float m = side * smoothstep(4445.0, 4365.0, x.x) * smoothstep(1035.0, 1085.0, x.y)
			* smoothstep(580.0, 520.0, length(d)) * smoothstep(3990.0, 4030.0, x.x);
		if (m > 0.0)
		{
			float a = -JAW_OPEN * g_Jaw * m;
			p = (JAW_HINGE + rot2(d, vec2(cos(a), sin(a)))) / ARM_PX;
		}
	}
#endif
	return p;
}

vec2 lookUv(float px)
{
	return vec2(g_LookX, g_LookY) * px / ARM_PX;
}

// Eye look + blink, last in the forward chain of a spin eye: undone before the spin.
vec2 eyeMod(vec2 p, vec2 c, float rpx, float lookPx, float blink)
{
	vec2 d = (p - c) * ARM_PX;
	float r2 = dot(d, d) / (rpx * rpx);
	if (r2 < 1.0)
	{
		float prof = (1.0 - r2) * (1.0 - r2);
		d -= vec2(g_LookX, g_LookY) * lookPx * prof;
		d.y /= 1.0 - BLINK_SQUASH * blink;
		p = c + d / ARM_PX;
	}
	return p;
}

vec2 opFace(vec2 p)
{
#if R_FACE
	if (inBox(p, BOX_FACE))
	{
		vec4 f = texSample2D(g_Texture5, (p - BOX_FACE_RECT.xy) / BOX_FACE_RECT.zw);   // cropped pack
		p += rigWave(FACE_SPEED, f.b) * FACE_AMP2 * flowOf(f.rg);
	}
#endif
	return p;
}

// ---- WE twirl: elliptical, repeat, no noise, no inner, no mask ----
vec2 opTwirl(vec2 p, vec2 center, vec2 axis, float ratio, float size, float feather, float angle)
{
	vec2 t = p - center;
	t.x *= ASPECT;
	t = rot2(t, axis);
	t.x *= ratio;
	float len = length(t);
	float fe = smoothstep(size + feather + 0.00001, size - feather, len);
	if (fe <= 0.0)
	{
		return p;
	}
	float anim = angle * len / size;
	t = rot2(t, vec2(cos(anim), sin(anim)));
	t.x /= ratio;
	t = rot2(t, vec2(axis.x, -axis.y));
	t.x /= ASPECT;
	return mix(p, frac(t + center), fe);
}

// ---- WE spin: elliptical, repeat, no noise, no mask; returns the soft mask, q = rotated point ----
float spinMask(vec2 p, vec2 center, vec2 axis, float ratio, float size, float feather)
{
	vec2 v = p - center;
	v.x *= ASPECT;
	v = rot2(v, axis);
	v.x *= ratio;
	return smoothstep(size + feather + 0.00001, size - feather, length(v));
}

vec2 spinPoint(vec2 p, vec2 center, vec2 axis, float ratio, vec2 spin)
{
	vec2 v = p - center;
	v.x *= ASPECT;
	v = rot2(v, axis);
	v.x *= ratio;
	v = rot2(v, spin);
	v.x /= ratio;
	v = rot2(v, vec2(axis.x, -axis.y));
	v.x /= ASPECT;
	return frac(v + center);
}

// ---- WE iris with an opacity mask, no background ----
vec2 opIris(vec2 p, float mask, vec2 da)
{
	return p + da * mask;
}

// ---- WE foliage sway, UV mode, opacity mask, util/noise ----
vec2 opFoliage(vec2 p, float mask, float noiseScale, vec2 noiseDir, vec2 dirCS, float amp0, float phaseK, float speed, float power)
{
	if (mask <= 0.0)
	{
		return p;
	}
	float noise = texSample2D(g_Texture9, p * noiseScale).g;
	float amp = amp0 * mask;
	vec2 pr = rot2(p, dirCS);
	float phase = (noise * M_PI * 2.0 + pr.x * 10.0 + pr.y * 5.0) * phaseK;
	vec4 sines = sin(phase + speed * g_Time * vec4(1, -0.16161616, 0.0083333, -0.00019841));
	vec4 csines = sin(0.4 + phase + speed * g_Time * vec4(-0.5, 0.041666666, -0.0013888889, 0.000024801587));
	sines = pow(abs(sines), CAST4(power)) * sign(sines);
	csines = pow(abs(csines), CAST4(power)) * sign(csines);
	return p + vec2(noiseDir.x * dot(sines, CAST4(amp)), noiseDir.y * dot(csines, CAST4(amp)));
}

// ---- WE water waves, opacity mask, single wave, no perspective ----
vec2 opWaves(vec2 p, float mask)
{
	if (mask <= 0.0)
	{
		return p;
	}
	float dist = g_Time * WW_SPEED + dot(p, WW_DIR) * WW_SCALE;
	float val = sin(dist);
	return p + pow(abs(val), WW_EXP) * sign(val) * vec2(WW_DIR.y, -WW_DIR.x) * WW_STRENGTH2 * mask;
}

// ---- the walk, from the last effect back to the first ----

// Rigs (applied in reverse: Face, Belly, Head & Body, Tail, Hair).
vec2 walkRigs(vec2 p)
{
	p = opLean(p);
	p = opJaw(p);
	p = opFace(p);
	p = opBelly(p);
	p = opHeadBody(p);
	p = opTail(p);
	p = opHair(p);
	return p;
}

// Honeycomb, Strings Back, Strings Hair (effects 14, 13, 12).
vec2 walkLate(vec2 p, ANIM_PARAMS)
{
#if E_W2
	p = opTwirl(p, W2_CENTER, W2_AXIS, W2_RATIO, W2_SIZE, W2_FEATHER, aMisc.y);
#endif
#if E_F3
	if (inBox(p, BOX_F3)) p = opFoliage(p, texSample2D(g_Texture7, p).g, F3_NSCALE, F3_NDIR, F3_DIR, F3_AMP0, F3_PHASE, F3_SPEED, F3_POWER);
#endif
#if E_F2
	if (inBox(p, BOX_F2)) p = opFoliage(p, texSample2D(g_Texture7, p).r, F2_NSCALE, F2_NDIR, F2_DIR, F2_AMP0, F2_PHASE, F2_SPEED, F2_POWER);
#endif
	return p;
}

// Balance, Tail edge shimmer, Nose twirl, Little Eyes, Guelras, Olho menor (effects 9..4).
vec2 walkMid(vec2 p, ANIM_PARAMS)
{
#if E_SH
	if (inBox(p, BOX_SH)) p += aMisc.z * SH_AMP2 * flowOf(texSample2D(g_Texture4, p).ba);
#endif
#if E_WW
	if (inBox(p, BOX_WW)) p = opWaves(p, texSample2D(g_Texture6, p).a);
#endif
#if E_W1
	p = opTwirl(p, W1_CENTER, W1_AXIS, W1_RATIO, W1_SIZE, W1_FEATHER, aMisc.x);
#endif
#if E_I2 && LAYOUT != 2
	if (inBox(p, BOX_I2)) p = opIris(p, texSample2D(g_Texture6, p).g, aIris.zw - lookUv(LOOK_IRIS));
#endif
#if E_F1
	if (inBox(p, BOX_F1))
	{
		float gm = texSample2D(g_Texture6, p).b;
		p = BLUR_CENTER + (p - BLUR_CENTER) * (1.0 - GILL_FLARE * g_Loud * gm);   // gills flare when loud
		p = opFoliage(p, gm, F1_NSCALE, F1_NDIR, F1_DIR, F1_AMP0, F1_PHASE, F1_SPEED, F1_POWER);
	}
#endif
#if E_I1
	if (inBox(p, BOX_I1)) p = opIris(p, texSample2D(g_Texture6, p).r, aIris.xy - lookUv(LOOK_IRIS));
#endif
	return p;
}

// A spin step on the (pA, pB, w) pair: colour = mix(X(pA), X(pB), w).
void spinStep(inout vec2 pA, inout vec2 pB, inout float w, inout float split,
	vec2 center, vec2 axis, float ratio, float size, float feather, vec2 spin, vec2 eye)
{
	float m = spinMask(pA, center, axis, ratio, size, feather);
	if (m > 0.0)
	{
		// look + blink (eye.x = look px, eye.y = blink), then the spin where the point still is in the disc
		vec2 e = eyeMod(pA, center, size * ARM_PX.y, eye.x, eye.y);
		vec2 q = mix(e, spinPoint(e, center, axis, ratio, spin), spinMask(e, center, axis, ratio, size, feather));
		if (m >= 1.0)
		{
			pA = q;
		}
		else if (split < 0.5)
		{
			pB = q;
			w = m;
			split = 1.0;
		}
		else
		{
			pA = mix(pA, q, m);   // two rims at once: does not happen with these eyes
		}
	}
	if (split > 0.5)
	{
		float mb = spinMask(pB, center, axis, ratio, size, feather);
		if (mb > 0.0)
		{
			vec2 eb = eyeMod(pB, center, size * ARM_PX.y, eye.x, eye.y);
			pB = mix(pB, mix(eb, spinPoint(eb, center, axis, ratio, spin), spinMask(eb, center, axis, ratio, size, feather)), mb);
		}
	}
}

vec4 readTex(vec2 p, ANIM_PARAMS)
{
	vec4 c = texSample2D(g_Texture0, (p - g_UvRect.xy) / g_UvRect.zw);
	c.a = min(c.a, g_AlphaMax);      // M: its old motion blur kept the pulsed image in an 8-bit buffer
#if BLINK
	if (inBox(p, BOX_BLINK))
	{
		vec4 m = texSample2D(BLINK_TEX, p);
		float m5 = texSample2D(g_Texture7, p).b;
		c.a *= (1.0 - m.r * (1.0 - aBlink.x)) * (1.0 - m.g * (1.0 - aBlink.y))
			* (1.0 - m.b * (1.0 - aBlink.z)) * (1.0 - m.a * (1.0 - aBlink.w))
			* (1.0 - m5 * (1.0 - aMisc2.x));
	}
#endif
	return c;
}

// Olhar and Olho (effects 2, 3) and the texture read, for a point that has been through the rest.
vec4 walkEarly(vec2 pA, vec2 pB, float w, float split, ANIM_PARAMS)
{
#if E_S2
	spinStep(pA, pB, w, split, S2_CENTER, S2_AXIS, S2_RATIO, S2_SIZE, S2_FEATHER, aSpin12.zw, vec2(LOOK_BIG, g_Blink));
#endif
#if E_S1
	spinStep(pA, pB, w, split, S1_CENTER, S1_AXIS, S1_RATIO, S1_SIZE, S1_FEATHER, aSpin12.xy, vec2(LOOK_BIG, g_Blink));
#endif
	vec4 c = readTex(pA, ANIM_ARGS);
	if (split > 0.5)
	{
		c = mix(c, readTex(pB, ANIM_ARGS), w);
	}
	return c;
}

// The whole chain for one sample point (full uv) entering after the lens.
vec4 chain(vec2 p, ANIM_PARAMS)
{
	p = walkRigs(p);
	p = walkLate(p, ANIM_ARGS);
	vec2 pB = p;
	float w = 0.0;
	float split = 0.0;
#if E_S4
	spinStep(p, pB, w, split, S4_CENTER, S4_AXIS, S4_RATIO, S4_SIZE, S4_FEATHER, aSpin34.zw, vec2(LOOK_SMALL, 0.0));
#endif
#if E_S3
	spinStep(p, pB, w, split, S3_CENTER, S3_AXIS, S3_RATIO, S3_SIZE, S3_FEATHER, aSpin34.xy, vec2(LOOK_SMALL, 0.0));
#endif
	p = walkMid(p, ANIM_ARGS);
	if (split > 0.5)
	{
		pB = walkMid(pB, ANIM_ARGS);
	}
	return walkEarly(p, pB, w, split, ANIM_ARGS);
}

#if LAYOUT == 2
// K pass 1: Little Eyes on top of the Guelras radial blur on top of the earlier effects.
vec4 preBlur(vec2 q, ANIM_PARAMS)
{
	q = walkMid(q, ANIM_ARGS);
	return walkEarly(q, q, 0.0, 0.0, ANIM_ARGS);
}

vec4 kPre(vec2 p, ANIM_PARAMS)
{
	if (inBox(p, BOX_I2)) p = opIris(p, texSample2D(g_Texture6, p).g, aIris.zw - lookUv(LOOK_IRIS));
	vec4 c = preBlur(p, ANIM_ARGS);
	if (inBox(p, BOX_BLUR))
	{
		float mb = texSample2D(g_Texture7, p).a;
		if (mb > 0.0)
		{
			vec2 delta = p - BLUR_CENTER;
			float amt = BLUR_SCALE * 0.025;
			vec2 r1 = rot2(delta, vec2(cos(1.4091998770852122 * amt), sin(1.4091998770852122 * amt))) - delta;
			vec2 r2 = rot2(delta, vec2(cos(3.2979348079914822 * amt), sin(3.2979348079914822 * amt))) - delta;
			vec2 r3 = rot2(delta, vec2(cos(5.2062900776825969 * amt), sin(5.2062900776825969 * amt))) - delta;
			vec4 b = c * 0.1976406528809576
				+ (preBlur(p + r1, ANIM_ARGS) + preBlur(p - r1, ANIM_ARGS)) * 0.2959855056006557
				+ (preBlur(p + r2, ANIM_ARGS) + preBlur(p - r2, ANIM_ARGS)) * 0.0935333619980593
				+ (preBlur(p + r3, ANIM_ARGS) + preBlur(p - r3, ANIM_ARGS)) * 0.0116608059608062;
			c = mix(c, b, mb);
		}
	}
	return c;
}
#endif

void main() {
	vec2 uv = v_TexCoord.zw;                         // full uv of this output pixel
	// colour split: on beats a colour layer drifts further from K along its own offset (and scale)
	uv -= g_Beat * SPLIT_GAIN * (g_Split.xy + g_Split.z * (uv - vec2(0.5, 0.5)));
	vec4 aSpin12 = v_Spin12;
	vec4 aSpin34 = v_Spin34;
	vec4 aIris = v_Iris;
	vec4 aMisc = v_Misc;
	vec4 aBlink = v_Blink;
	vec4 aMisc2 = v_Misc2;
	vec4 c = CAST4(0.0);

#if LAYOUT == 2
	if (dot(texSample2D(SUPPORT_TEX, uv), g_SupportSel) > 0.0)
	{
		c = kPre(uv, ANIM_ARGS);
	}
#else
	// Lens distortion (workshop 2811235087: barrel + chromatic aberration) and its fold clip
	vec2 base = uv - LENS_CENTER;
	vec2 d = base / LENS_SCALE;
	float len2 = dot(d, d);
	float clip = 1.0 - smoothstep(FOLD_FROM, FOLD_TO, len2);
	vec2 uvG = LENS_CENTER + base * (1.0 + LENS_K * len2);
	if (clip > 0.0 && dot(texSample2D(SUPPORT_TEX, uvG), g_SupportSel) > 0.0)
	{
		vec2 uvR = LENS_CENTER + base * (1.0 + (LENS_K + LENS_CA) * len2);
		vec2 uvB = LENS_CENTER + base * (1.0 + (LENS_K - LENS_CA) * len2);
		bool posed = false;
		// the rest of the layer: pre-arm sink, then the joint fan around the arm's base
		vec2 rG = uvG;
		if (g_ArmPose > 0.0005)
		{
			vec2 q = uvG * ARM_PX;
			float w = armBelow(q);
			rG = armFan(armSink(q, g_ArmPose, w), g_ArmPose, w) / ARM_PX;
		}
		vec2 rR = rG + (uvR - uvG);
		vec2 rB = rG + (uvB - uvG);
#if R_TAIL
		if (g_ArmPose > 0.0005 && inBox(uvG, ARM_BOX))
		{
			// the arm (moved) over the rest of the layer (with the arm's old place emptied)
			posed = true;
			vec4 rot = CAST4(0.0);
			vec4 pz = armPose(uvG * ARM_PX, rG * ARM_PX, g_ArmPose, rot);   // xy = arm source px, z = in the posed band
			// The band tests run on the points the chain really reads, after the rigs (mouse lean, sway):
			// the old place hides exactly the arm texture it would show, and the moved arm shows only arm
			// texture. Testing the unwarped points left a ghost of the tip mid-reach (lean pushed it out of
			// the narrow head-side band, 2026-11-09 recording).
			vec2 hb = armRestBand(walkRigs(rG) * ARM_PX);
			float hide = max(hb.x, hb.y * min(1.0, g_ArmPose / 0.2));
			vec4 rest = CAST4(0.0);
			if (hide < 0.999)
			{
				rest = chain(rG, ANIM_ARGS);
				rest.r = chain(rR, ANIM_ARGS).r;
				rest.b = chain(rB, ANIM_ARGS).b;
				rest.a *= 1.0 - hide;   // the old arm's place: hidden, fading back in on the head side
			}
			c = rest;
			if (pz.z > 0.5 && armRestBand(walkRigs(pz.xy / ARM_PX) * ARM_PX).x > 0.5)
			{
				// chromatic aberration offsets turn with the arm
				vec2 sp = pz.xy / ARM_PX;
				vec2 dR = rot2((uvR - uvG) * ARM_PX, rot.xy) / ARM_PX;
				vec2 dB = rot2((uvB - uvG) * ARM_PX, rot.xy) / ARM_PX;
				vec4 arm = chain(sp, ANIM_ARGS);
				arm.r = chain(sp + dR, ANIM_ARGS).r;
				arm.b = chain(sp + dB, ANIM_ARGS).b;
				float o = arm.a + rest.a * (1.0 - arm.a);
				c = vec4((arm.rgb * arm.a + rest.rgb * rest.a * (1.0 - arm.a)) / max(o, 0.00001), o);
			}
		}
#endif
		if (!posed)
		{
			c = chain(rG, ANIM_ARGS);
			c.r = chain(rR, ANIM_ARGS).r;
			c.b = chain(rB, ANIM_ARGS).b;
		}
		c.a *= clip;
	}
#endif
	gl_FragColor = c;
}
