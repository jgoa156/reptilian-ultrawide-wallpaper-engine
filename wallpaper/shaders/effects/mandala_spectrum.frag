// GENERATED by scripts/optimize_creature.py: mandala alpha read from an R8 texture (.r).

// Spectrum mandala (fragment), one pass. It replaces the spin, the breathing and the glitch
// slices that the mandala had before.
//
//  * The 13-fold Choronzon mandala (g_Texture2) spins all the time: one full turn every
//    g_TurnPeriod s (user property `spinperiod`, default 39), idle or with music. The controller
//    script drives the angle (g_SpinPhase) so the speed can follow the song's tempo
//    (`mandalabpmspin`, `mandalabeatsperpiece`) and glide without a jump.
//  * Idle (g_Slice = 0) it is the FULL mandala, breathing (g_Floor, from the controller).
//    With music (g_Slice -> 1) it splits into 13 pieces, one per figure. Each piece fades out
//    toward both sides (g_Feather) and darkens only with its own part of the spectrum
//    (arm0..arm12, from the controller).
//  * Rainbow Rings-style bulge: a piece grows outward with its band (g_Bulge), and the whole
//    mandala swells with the bass (g_BassScale).
//  * Module Visualizer-style datamosh: on bass hits the controller sets g_Mosh, a seed and an
//    error count. Each "error" works like a swapped byte in a JPEG: every block after it, in scan
//    order, shifts sideways and changes density, and a few blocks at the error turn to garbage.
//  * Leonard glitch (Master Leonard, goat-mimic): on a beat, thin horizontal slices shear
//    sideways (g_GlitchSlices > 0). It only moves pixels.
//  * Opacity: a piece at level L (0..1, the darkness above) gets mix(min, max, L), with
//    g_MinOpacity / g_MaxOpacity in percent (user properties `mandalaminopacity` /
//    `mandalamaxopacity`, defaults 0 / 15). It must live here: WE applies a layer's own alpha when
//    it draws the layer image, and this effect replaces that image, so the layer alpha is lost.
//  * Blur: g_Blur canvas px (user property `mandalablur`, default 0), a 12-tap disc on the ink
//    read from a matching mip level.
//  * The eye (g_Eye, user property `mandalaeye`): a procedural reptile eye in the mandala's centre,
//    drawn in the same black ink. It clears an almond window (and a thin halo) in the mandala, has a
//    double lid line with 13 spikes, a ringed iris whose striations turn with the mandala's spin, a
//    slit pupil that widens with the bass, and it blinks. The controller script points the iris at
//    the cursor (g_EyeLookX/Y) and drives the blink. Its opacity is its own (`mandalaeyeopacity`).
//
// The layer itself is a transparent canvas-sized image (it only sets the output size). All
// coordinates are in mandala radii: the mandala spans the unit disc.

#include "common.h"

varying vec4 v_TexCoord;

uniform sampler2D g_Texture0; // {"hidden":true}
uniform sampler2D g_Texture2; // {"label":"Mandala","default":"masks/mandala_alpha"}

uniform float g_Time;

// piece levels 0..1, set every frame by scripts/mandala_controller.js (arms clockwise from the top)
uniform float g_Arm0; // {"material":"arm0","label":"Piece 0 level","default":0,"range":[0,1]}
uniform float g_Arm1; // {"material":"arm1","label":"Piece 1 level","default":0,"range":[0,1]}
uniform float g_Arm2; // {"material":"arm2","label":"Piece 2 level","default":0,"range":[0,1]}
uniform float g_Arm3; // {"material":"arm3","label":"Piece 3 level","default":0,"range":[0,1]}
uniform float g_Arm4; // {"material":"arm4","label":"Piece 4 level","default":0,"range":[0,1]}
uniform float g_Arm5; // {"material":"arm5","label":"Piece 5 level","default":0,"range":[0,1]}
uniform float g_Arm6; // {"material":"arm6","label":"Piece 6 level","default":0,"range":[0,1]}
uniform float g_Arm7; // {"material":"arm7","label":"Piece 7 level","default":0,"range":[0,1]}
uniform float g_Arm8; // {"material":"arm8","label":"Piece 8 level","default":0,"range":[0,1]}
uniform float g_Arm9; // {"material":"arm9","label":"Piece 9 level","default":0,"range":[0,1]}
uniform float g_Arm10; // {"material":"arm10","label":"Piece 10 level","default":0,"range":[0,1]}
uniform float g_Arm11; // {"material":"arm11","label":"Piece 11 level","default":0,"range":[0,1]}
uniform float g_Arm12; // {"material":"arm12","label":"Piece 12 level","default":0,"range":[0,1]}
uniform float g_Bass; // {"material":"bass","label":"Bass level","default":0,"range":[0,1]}

uniform vec2 g_UnitScale; // {"material":"unitscale","label":"Layer size in mandala radii","default":"3.41333 1.44"}
uniform float g_TurnPeriod; // {"material":"turnperiod","label":"Spin: seconds per full turn","default":39,"range":[1,600]}
// spin angle in turns, integrated by scripts/mandala_controller.js (it can follow the song's tempo
// without jumping); until the script runs, the spin is g_Time / g_TurnPeriod
uniform float g_SpinPhase; // {"material":"spinphase","label":"Spin phase (turns, set by script)","default":0,"range":[0,1]}
uniform float g_SpinScripted; // {"material":"spinscripted","label":"Spin set by script (0/1)","default":0,"range":[0,1]}
uniform float g_Feather; // {"material":"feather","label":"Piece side fade","default":0.35,"range":[0,1]}
uniform float g_Floor; // {"material":"floor","label":"Piece level in silence","default":0.6,"range":[0,1]}
uniform float g_Slice; // {"material":"slice","label":"Sliced (0 = full mandala, 1 = 13 pieces)","default":0,"range":[0,1]}
uniform float g_MinOpacity; // {"material":"minopacity","label":"Min opacity (%)","default":0,"range":[0,100]}
uniform float g_MaxOpacity; // {"material":"maxopacity","label":"Max opacity (%)","default":15,"range":[0,100]}
uniform float g_Blur; // {"material":"blur","label":"Blur (canvas px)","default":0,"range":[0,100]}
uniform float g_Bulge; // {"material":"bulge","label":"Piece bulge","default":0.1,"range":[0,1]}
uniform float g_BassScale; // {"material":"bassscale","label":"Bass swell","default":0.04,"range":[0,0.5]}

uniform float g_Mosh; // {"material":"mosh","label":"Datamosh opacity","default":0,"range":[0,1]}
uniform float g_MoshSeed; // {"material":"moshseed","label":"Datamosh seed","default":0,"range":[0,1000]}
uniform float g_MoshErrors; // {"material":"mosherrors","label":"Datamosh errors","default":3,"range":[0,6]}
uniform vec2 g_MoshGrid; // {"material":"moshgrid","label":"Datamosh blocks","default":"160 68"}

uniform float g_GlitchSlices; // {"material":"glitchslices","label":"Glitch slices (0 = off)","default":0,"range":[0,7]}
uniform float g_GlitchSeed; // {"material":"glitchseed","label":"Glitch seed","default":0,"range":[0,1000]}
uniform float g_GlitchShift; // {"material":"glitchshift","label":"Glitch shift (radii)","default":0.1,"range":[0,1]}

uniform float g_Eye; // {"material":"eye","label":"Centre eye (0/1)","default":1,"range":[0,1]}
uniform float g_EyeOpacity; // {"material":"eyeopacity","label":"Centre eye opacity (%)","default":35,"range":[0,100]}
uniform float g_EyeLookX; // {"material":"eyelookx","label":"Eye look x (-1..1, set by script)","default":0,"range":[-1,1]}
uniform float g_EyeLookY; // {"material":"eyelooky","label":"Eye look y (-1..1, screen down, set by script)","default":0,"range":[-1,1]}
uniform float g_EyeBlink; // {"material":"eyeblink","label":"Eye blink (0..1, set by script)","default":0,"range":[0,1]}

#define EYE_R 0.17            // half width of the almond, mandala radii
#define EYE_H 0.48            // half height at the middle, in EYE_R
#define EYE_LINE 0.022        // lid line half thickness, in EYE_R
#define EYE_IRIS 0.4          // iris radius, in EYE_R
#define EYE_LOOK vec2(0.42, 0.16)   // how far the iris travels, in EYE_R
#define EYE_PUPIL_W 0.07      // slit half width, in EYE_R (x (1 + 1.4 bass))
#define EYE_HALO 0.44         // the mandala fades back in over this distance outside the lid, in EYE_R

float hash11(float x)
{
	return frac(sin(x * 12.9898 + 78.233) * 43758.5453);
}

float armLevel(float k)
{
	vec4 i0 = vec4(0.0, 1.0, 2.0, 3.0);
	return dot(vec4(g_Arm0, g_Arm1, g_Arm2, g_Arm3), step(abs(i0 - CAST4(k)), CAST4(0.5)))
		+ dot(vec4(g_Arm4, g_Arm5, g_Arm6, g_Arm7), step(abs(i0 + CAST4(4.0 - k)), CAST4(0.5)))
		+ dot(vec4(g_Arm8, g_Arm9, g_Arm10, g_Arm11), step(abs(i0 + CAST4(8.0 - k)), CAST4(0.5)))
		+ g_Arm12 * step(abs(12.0 - k), 0.5);
}

// mandala ink alpha at a point in mandala space (unit disc, y down)
float ink(vec2 p)
{
	float inside = step(length(p), 0.999);
	return texSample2DLod(g_Texture2, p * 0.5 + CAST2(0.5), 0.0).r * inside;   // explicit LOD: safe inside branches
}

// blurred ink: 12-tap disc (radius g_Blur canvas px; 1500 canvas px per radius, 2048 texels per
// radius), sampled from the mip level that matches the tap spacing
float inkBlur(vec2 p)
{
	if (g_Blur < 0.5)
	{
		return ink(p);
	}
	float r = g_Blur / 1500.0;
	float lod = log2(max(g_Blur * 2048.0 / 1500.0 / 3.0, 1.0));
	float sum = 0.0;
	for (int i = 0; i < 12; ++i)
	{
		float fi = float(i);
		float ang = fi * 2.39996;                                     // golden angle spiral
		float rad = sqrt((fi + 0.5) / 12.0) * r;
		vec2 q = p + vec2(cos(ang), sin(ang)) * rad;
		sum += texSample2DLod(g_Texture2, q * 0.5 + CAST2(0.5), lod).r * step(length(q), 0.999);
	}
	return sum / 12.0;
}

// Leonard's torn slices: sideways shove (in mandala radii) for a screen-space row
float glitchShift(float y)
{
	float shift = 0.0;
	for (int i = 0; i < 7; ++i)
	{
		float fi = float(i);
		if (fi < g_GlitchSlices)
		{
			float h = g_GlitchSeed * 3.17 + fi * 5.71;
			float hh = (2.0 + hash11(h + 2.0) * 16.0) / 240.0;              // thin: 2..18 of Leonard's 480 px panel
			float y0 = mix(-0.8, 0.8, hash11(h + 1.0)) - hh * 0.5;
			float mag = (8.0 + floor(hash11(h + 4.0) * 23.0)) / 30.0;
			float sgn = hash11(h + 3.0) < 0.5 ? -1.0 : 1.0;
			if (y >= y0 && y < y0 + hh)
			{
				shift = sgn * mag * g_GlitchShift;
			}
		}
	}
	return shift;
}

// The centre eye at p (screen-aligned mandala radii, centred). Returns (eye ink, how much of the
// mandala it replaces).
vec2 eye(vec2 p, float spin, float bass)
{
	float aa = 0.0015 / EYE_R;                                       // ~1.5 canvas px
	vec2 e = p / EYE_R;
	float open = max(1.0 - g_EyeBlink, 0.03);
	float hl = EYE_H * max(1.0 - e.x * e.x, 0.0);
	float slope = 2.0 * EYE_H * e.x * open;
	float f = (abs(e.y) - hl * open) / sqrt(1.0 + slope * slope);   // ~distance to the lids, < 0 inside
	if (abs(e.x) >= 1.0)
	{
		f = length(vec2(abs(e.x) - 1.0, e.y));                        // pointed corners
	}
	float lid = 1.0 - smoothstep(EYE_LINE - aa, EYE_LINE + aa, abs(f));
	float lid2 = (1.0 - smoothstep(0.009 - aa, 0.009 + aa, abs(f - 0.11))) * step(abs(e.x), 1.08);
	// 13 spikes over the lids (the mandala is 13-fold), tapering outward
	float sx = e.x * 6.5 + 6.5;
	float sp = abs(frac(sx) - 0.5);
	float sh = saturate((f - 0.11) / 0.3);                            // 0 at the outer lid line .. 1 at the tip
	float sw = 0.17 * (1.0 - sh) * (1.0 - sh);                      // curved taper
	float spike = step(0.0, f - 0.11) * step(sh, 0.999) * (1.0 - smoothstep(sw - aa, sw + aa, sp))
		* step(abs(e.x), 0.97);
	float inside = 1.0 - smoothstep(-aa, aa, f);
	// iris: limbal ring, an inner ring, striations turning with the spin
	vec2 d = e - vec2(g_EyeLookX, g_EyeLookY) * EYE_LOOK;
	float r = length(d);
	float ang = atan2(d.x, -d.y) + spin;
	float iris = 1.0 - smoothstep(EYE_IRIS - aa, EYE_IRIS + aa, r);
	float limbus = smoothstep(EYE_IRIS - 0.075, EYE_IRIS - 0.045, r);
	float ring = 1.0 - smoothstep(0.012 - aa, 0.012 + aa, abs(r - EYE_IRIS * 0.62));
	float stri = step(0.58, 0.5 + 0.5 * cos(ang * 26.0 + 2.5 * sin(r * 38.0 - spin * 2.0)))
		* smoothstep(EYE_IRIS * 0.22, EYE_IRIS * 0.4, r);
	float irisInk = iris * max(max(limbus, ring), stri);
	// slit pupil, wider with the bass
	float pw = EYE_PUPIL_W * (1.0 + 1.4 * bass);
	float pu = length(vec2(d.x / pw, d.y / (EYE_IRIS * 0.86)));
	float pupil = 1.0 - smoothstep(1.0 - aa / pw, 1.0 + aa / pw, pu);
	float glint = 1.0 - smoothstep(0.055 - aa, 0.055 + aa, length(d - vec2(-0.12, -0.13)));
	float eInk = max(max(lid, max(lid2, spike)), inside * max(irisInk, pupil) * (1.0 - glint));
	float cover = 1.0 - smoothstep(0.0, EYE_HALO, f);
	return vec2(eInk, cover);
}

float render(vec2 uv)
{
	float angle = mix(g_Time / max(g_TurnPeriod, 0.1), g_SpinPhase, step(0.5, g_SpinScripted)) * M_PI_2;
	vec2 pos = (uv - CAST2(0.5)) * g_UnitScale;                      // screen-aligned, in mandala radii
	if (g_GlitchSlices > 0.0)
	{
		pos.x -= glitchShift(pos.y);
	}
	vec2 q = rotateVec2(pos, angle);                                 // mandala space, rides the spin
	float phi = atan2(q.x, -q.y);                                    // from the top, clockwise
	float w = M_PI_2 / 13.0;
	float k = floor(phi / w + 0.5);
	float d = phi - k * w;
	k = mod(k + 13.0, 13.0);
	float lv = armLevel(k);
	float bass = g_Bass;

	// the piece: its own scale (bulge), the side fades (only when sliced), its audio level
	float side = smoothstep(0.5 * w, 0.5 * w * (1.0 - g_Feather), abs(d));
	side = mix(1.0, side, g_Slice);                                   // idle: the full mandala
	vec2 src = q / ((1.0 + g_Bulge * lv) * (1.0 + g_BassScale * bass));
	float level = g_Floor + (1.0 - g_Floor) * lv;
	float a = inkBlur(src) * side * mix(g_MinOpacity, g_MaxOpacity, level) * 0.01;
	if (g_Eye > 0.5)
	{
		vec2 ey = eye(pos / (1.0 + g_BassScale * bass), angle, bass);
		a = mix(a, ey.x * g_EyeOpacity * 0.01, ey.y);
	}

	return a;
}

// JPEG-style corruption: where does this pixel read from, and how dense is it there?
vec4 mosh(vec2 uv)
{
	vec2 cell = floor(uv * g_MoshGrid);
	vec2 inner = frac(uv * g_MoshGrid);
	float idx = cell.y * g_MoshGrid.x + cell.x;                      // block number in scan order
	float total = g_MoshGrid.x * g_MoshGrid.y;
	float shift = 0.0;
	float gain = 1.0;
	float garbage = 0.0;
	for (int i = 0; i < 6; ++i)
	{
		float fi = float(i);
		if (fi < g_MoshErrors)
		{
			float h = g_MoshSeed * 7.31 + fi * 13.17;
			float pos = floor(hash11(h) * total * 0.85);
			if (idx >= pos)
			{
				shift += floor(hash11(h + 1.0) * 5.0) - 2.0;              // +-2 blocks
				gain *= 0.9 + hash11(h + 2.0) * 0.3;
			}
			if (idx >= pos && idx < pos + 2.0 + floor(hash11(h + 3.0) * 4.0))
			{
				garbage = step(0.45, hash11(idx * 0.618 + h));
			}
		}
	}
	float s = max(idx - shift, 0.0);
	vec2 c2 = vec2(mod(s, g_MoshGrid.x), floor(s / g_MoshGrid.x));
	return vec4((c2 + inner) / g_MoshGrid, gain, garbage);
}

void main() {
	vec2 uv = v_TexCoord.xy;
	float a = render(uv);
	if (g_Mosh > 0.0)
	{
		vec4 m = mosh(uv);
		float am = max(saturate(render(m.xy) * m.z), m.w * 0.3 * g_MaxOpacity * 0.01);
		a = mix(a, am, saturate(g_Mosh));
	}
	gl_FragColor = vec4(0.0, 0.0, 0.0, saturate(a));
}
